  "gates": [
    {
      "id": "G-BASELINE",
      "criterion": "Complete semantic/primitive inventory and reproducible baseline.",
      "status": "not-run"
    },
    {
      "id": "G-CONTRACT",
      "criterion": "Reviewed contracts, canonical vectors, independent readers and rejection fixtures.",
      "status": "not-run"
    },
    {
      "id": "G-EXTRACT",
      "criterion": "Declared baseline extracts through KIR without mandatory CUDA or Karamel.",
      "status": "not-run"
    },
    {
      "id": "G-VERTICAL",
      "criterion": "Real-GPU SPIR-T/Vulkan path with correct results, errors and CUDA-free dependencies.",
      "status": "not-run"
    },
    {
      "id": "G-CONCURRENCY",
      "criterion": "Required memory, ownership, subgroup, atomic and async relations checked on qualified devices.",
      "status": "not-run"
    },
    {
      "id": "G-COVERAGE",
      "criterion": "All legacy inventory rows classified; all claimed features qualified for the release profile.",
      "status": "not-run"
    },
    {
      "id": "G-TRUST",
      "criterion": "O1-O10 evidence/dispositions complete; assumptions explicit; no silently discharged obligations.",
      "status": "not-run"
    },
    {
      "id": "G-ADD-COMPILER",
      "criterion": "Independent compiler plugin installed against immutable core with no existing source/build edits.",
      "status": "not-run"
    },
    {
      "id": "G-ADD-RUNTIME",
      "criterion": "Distinct real runtime/API installed and tested without changing the core or existing applications.",
      "status": "not-run"
    },
    {
      "id": "G-ADD-LANGUAGE",
      "criterion": "Independent frontend and host binding reuse unchanged contracts, compiler and runtime.",
      "status": "not-run"
    },
    {
      "id": "G-ADD-OP",
      "criterion": "Semantic extension installs additively and fails safely when its required support is absent.",
      "status": "not-run"
    },
    {
      "id": "G-PRODUCTION",
      "criterion": "Hardware, workload, performance, operational, packaging and rollback matrix passes.",
      "status": "not-run"
    },
    {
      "id": "G-CUDA-FREE",
      "criterion": "Default new path builds, installs and runs without CUDA toolkit/runtime, NVCC or mandatory Karamel.",
      "status": "not-run"
    },
    {
      "id": "G-MESA-DECISION",
      "criterion": "Measured one-driver comparison supports an explicit promote/defer decision.",
      "status": "not-run"
    }
  ],
